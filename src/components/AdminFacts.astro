---
import { Image } from 'astro:assets';
import boss from '../assets/art/enemy_boss.webp';
import { t, type Locale } from '../i18n/t.ts';
import { BOT_INVITE } from './links.ts';

interface Props { locale: Locale }
const { locale } = Astro.props;
const FACTS = [1, 2, 3, 4] as const;
---
<section class="final"><Image class="bg" src={boss} alt="" widths={[800, 1600]} sizes="100vw" loading="lazy" /><div class="wrap">
  <h2>{t(locale, 'final.title')}</h2>
  <p class="sub">{t(locale, 'final.body')}</p>
  <a class="btn" href={BOT_INVITE}>{t(locale, 'hero.add')}</a>
  <div class="facts">
    {FACTS.map((fact) => <div><b>{t(locale, `facts.${fact}.title`)}</b><span>{t(locale, `facts.${fact}.body`)}</span></div>)}
  </div>
</div></section>

<style>
  .wrap{max-width:1180px;margin:0 auto;padding:0 16px}
  h2{font:800 clamp(40px,6vw,76px)/.98 var(--display);letter-spacing:-.015em}
  .final{position:relative;isolation:isolate;overflow:hidden;text-align:center;padding:150px 0 110px}
  .bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 22%;z-index:-2;opacity:.8}
  .final::before{content:"";position:absolute;inset:0;z-index:-1;background:linear-gradient(180deg,var(--void),rgba(12,8,9,.55) 45%,var(--void))}
  .sub{margin:18px auto 0;color:var(--bone)}
  .btn{position:relative;display:inline-block;margin-top:36px;padding:16px 34px;font:700 19px var(--body);text-decoration:none;color:#fff;background:linear-gradient(180deg,#d32542,#9c1530);border:1px solid #e0566c;box-shadow:0 18px 40px -14px rgba(196,30,58,.9)}
  .btn::before,.btn::after{content:"";position:absolute;width:12px;height:12px;border:2px solid var(--bone)}
  .btn::before{left:-6px;top:-6px;border-right:0;border-bottom:0}
  .btn::after{right:-6px;bottom:-6px;border-left:0;border-top:0}
  .btn:hover{background:linear-gradient(180deg,#e02c4a,#a8183a)}
  .facts{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:24px;margin-top:72px;text-align:left}
  .facts b{display:block;font:700 21px var(--display)}
  .facts span{color:var(--ash);font-size:16px}
  @media (max-width:900px){.facts{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media (max-width:480px){.facts{grid-template-columns:minmax(0,1fr)}}
</style>
