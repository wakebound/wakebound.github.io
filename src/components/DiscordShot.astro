---
import { Image, getImage } from 'astro:assets';
import type { Locale } from '../i18n/t.ts';

interface Props { locale: Locale; name: 'board' | 'warning' | 'choice' | 'cleared'; alt: string; enlarge?: string }
const { locale, name, alt, enlarge } = Astro.props;
const shots = import.meta.glob<{ default: ImageMetadata }>('../assets/shots/*/*.png', { eager: true });
const shot = shots[`../assets/shots/${locale}/${name}.png`];
if (!shot) {
  throw new Error(`missing Discord shot ${locale}/${name}`);
}
const width = Math.min(shot.default.width, 1000);
const full = enlarge ? await getImage({ src: shot.default, format: 'webp', width: shot.default.width }) : undefined;
---
{full ? (
  <a href={full.src} target="_blank" rel="noopener"><Image src={shot.default} alt={alt} width={width} format="webp" class="discord-shot" /></a>
  <span class="hint">{enlarge}</span>
) : (
  <Image src={shot.default} alt={alt} width={width} format="webp" class="discord-shot" />
)}

<style>
  .discord-shot{width:100%;height:auto;border-radius:8px;border:1px solid #1e1f22;box-shadow:0 40px 80px -30px rgba(0,0,0,.9)}
  .hint{display:none;margin:6px 16px 0;font:16px/1.4 var(--sys);color:var(--ash)}
  @media (max-width:560px){.hint{display:block}}
</style>
