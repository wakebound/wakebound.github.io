---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import workshop from '../assets/art/banner_workshop.webp';
import sceneIce from '../assets/art/banner_scene_ice.webp';
import sceneVolcano from '../assets/art/banner_scene_volcano.webp';
import brute from '../assets/art/enemy_brute.webp';
import agile from '../assets/art/enemy_agile.webp';
import caster from '../assets/art/enemy_caster.webp';
import swarm from '../assets/art/enemy_swarm.webp';
import boss from '../assets/art/enemy_boss.webp';
import { t, type Locale } from '../i18n/t.ts';

interface Props { locale: Locale }
const { locale } = Astro.props;

const RANKS = ['E', 'D', 'C', 'B', 'A', 'S'] as const;
const RARITIES = ['common', 'uncommon', 'rare', 'epic'] as const;
const FOES = [['brute', brute], ['agile', agile], ['caster', caster], ['swarm', swarm], ['boss', boss]] as const;

const pictures = import.meta.glob<{ default: ImageMetadata }>('../assets/catalog/*', { eager: true });
const picture = (filename: string): ImageMetadata => {
  const found = pictures[`../assets/catalog/${filename}`];
  if (!found) throw new Error(`catalog picture missing: src/assets/catalog/${filename}`);
  return found.default;
};

const rowId = (entry: { id: string }): number => Number(entry.id.slice(entry.id.lastIndexOf('-') + 1));
const portals = (await getCollection('portals')).filter((entry) => entry.data.locale === locale).sort((a, b) => rowId(a) - rowId(b));
const ladder = RANKS.map((rank) => ({ rank, portal: portals.find((entry) => entry.data.rank === rank)?.data ?? null }));
const item = (await getCollection('items')).filter((entry) => entry.data.locale === locale).sort((a, b) => rowId(a) - rowId(b))[0]?.data ?? null;
---
<section class="world" id="world"><div class="wrap">
  <h2>{t(locale, 'world.title')}</h2>
  <div class="bento">
    <div class="cell c-ranks">
      <h3>{t(locale, 'world.ranks.title')}</h3>
      <p>{t(locale, 'world.ranks.body')}</p>
      <ol class="ladder">
        {ladder.map(({ rank, portal }) => (
          <li class:list={{ sealed: !portal }} style={`--rank:var(--r${rank})`}>
            <img src={`/icons/rank_${rank}.png`} alt={t(locale, `alt.rank.${rank}`)} width="34" height="34" />
            {portal ? (
              <>
                <b>{portal.name}</b>
                <span>{portal.kind === 'raid' ? t(locale, 'world.raid') : t(locale, 'world.solo')}</span>
                <Image class="thumb" src={picture(portal.image)} alt="" width={64} height={44} densities={[1, 2]} />
              </>
            ) : (
              <>
                <b>{t(locale, 'world.sealed')}</b>
                <span>{t(locale, 'world.notOpen')}</span>
              </>
            )}
          </li>
        ))}
      </ol>
    </div>
    <div class="cell c-foes">
      <div class="foes">
        {FOES.map(([id, src]) => <Image src={src} alt={t(locale, `alt.foe.${id}`)} width={200} height={267} densities={[1, 2]} />)}
      </div>
      <h3>{t(locale, 'world.foes.title')}</h3>
      <p>{t(locale, 'world.foes.body')}</p>
    </div>
    <div class="cell c-loot">
      {item && (
        <div class="item">
          <Image src={picture(item.image)} alt="" width={96} height={96} densities={[1, 2]} />
          <div><b>{item.name}</b><q>{item.description}</q></div>
        </div>
      )}
      <h3>{t(locale, 'world.loot.title')}</h3>
      <div class="rar">
        {RARITIES.map((rarity) => <img src={`/icons/rarity_${rarity}.png`} alt={t(locale, `alt.rarity.${rarity}`)} width="22" height="22" />)}
      </div>
    </div>
    <div class="cell art">
      <Image class="bg" src={workshop} alt="" widths={[480, 800]} sizes="(max-width:560px) 100vw, 300px" />
      <h3>{t(locale, 'world.forge.title')}</h3><p>{t(locale, 'world.forge.body')}</p>
    </div>
    <div class="cell art wide">
      <Image class="bg" src={sceneIce} alt="" widths={[600, 1000]} sizes="(max-width:560px) 100vw, 600px" />
      <h3>{t(locale, 'world.scenes.title')}</h3><p>{t(locale, 'world.scenes.body')}</p>
    </div>
    <div class="cell art wide">
      <Image class="bg" src={sceneVolcano} alt="" widths={[600, 1000]} sizes="(max-width:560px) 100vw, 600px" />
      <h3>{t(locale, 'world.anytime.title')}</h3><p>{t(locale, 'world.anytime.body')}</p>
    </div>
  </div>
</div></section>

<style>
  .wrap{max-width:1180px;margin:0 auto;padding:0 16px}
  .world{padding:120px 0}
  h2{font:800 clamp(40px,6vw,76px)/.98 var(--display);letter-spacing:-.015em}
  .bento{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));grid-auto-rows:minmax(220px,auto);gap:14px;margin-top:44px}
  .cell{position:relative;isolation:isolate;overflow:hidden;border:1px solid var(--edge);background:var(--crypt);padding:24px;display:flex;flex-direction:column;justify-content:flex-end}
  .cell h3{font:800 30px/1.05 var(--display)}
  .cell p{color:var(--ash);font-size:17px;margin-top:6px;max-width:40ch}
  .cell .bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:-2}
  .cell.art::after{content:"";position:absolute;inset:0;z-index:-1;background:linear-gradient(180deg,rgba(12,8,9,.1),rgba(12,8,9,.94) 70%)}
  .cell.art p{color:var(--bone)}
  .wide{grid-column:span 2}
  .c-ranks{grid-column:span 2;grid-row:span 2;justify-content:flex-start}
  .ladder{list-style:none;display:grid;margin-top:22px}
  .ladder li{display:grid;grid-template-columns:34px minmax(0,1fr) auto auto;gap:6px 14px;align-items:center;padding:10px 0 10px 12px;border-bottom:1px solid var(--edge);border-left:3px solid var(--rank);font-size:18px}
  .ladder img{width:34px;height:34px}
  .ladder b{font-weight:700;min-width:0;overflow-wrap:anywhere}
  .ladder span{color:var(--ash);font-size:16px;text-align:right}
  .ladder .thumb{width:64px;height:44px;object-fit:cover;border:1px solid var(--edge)}
  .ladder .sealed{border-left-color:var(--edge)}
  .ladder .sealed img{opacity:.45}
  .ladder .sealed b{color:var(--ash)}
  .c-foes{grid-column:span 2}
  .foes{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px;margin-bottom:auto}
  .foes img{width:100%;height:auto;aspect-ratio:3/4;object-fit:cover;border:1px solid var(--edge)}
  .c-foes h3{margin-top:14px}
  .c-loot .item{display:flex;flex-direction:column;gap:12px;align-items:flex-start;border-top:3px solid var(--rare);background:#100b0b;padding:12px;margin-bottom:auto}
  .c-loot .item img{width:64px;height:64px;object-fit:cover;flex:none}
  .c-loot .item b{font:700 20px var(--display);display:block}
  .c-loot .item q{display:block;color:var(--ash);font-style:italic;font-size:16px;margin-top:4px;quotes:none}
  .c-loot h3{margin-top:16px}
  .rar{display:flex;gap:6px;margin-top:14px}
  .rar img{width:22px;height:22px}
  @media (max-width:980px){.bento{grid-template-columns:repeat(2,minmax(0,1fr))}.c-ranks,.c-foes{grid-column:span 2}.c-ranks{grid-row:auto}}
  @media (max-width:560px){.bento{grid-template-columns:minmax(0,1fr)}.c-ranks,.c-foes,.wide{grid-column:auto}.ladder .thumb{display:none}.ladder li{grid-template-columns:34px minmax(0,1fr) auto}}
</style>
